# Static analysis gate.
#
# The constitution's floor is level 5. This project runs at level 6: a greenfield
# codebase costs nothing to start one level stricter, and the gate is "0 errors"
# either way. Do not lower this to reach zero — fix the code instead.

parameters:
    level: 6

    # The constitution's gate is level 6 over app/. config/ and public/ are analysed too
    # because they hold real logic (the PDO factory, the env loader, the front controller)
    # and excluding them would leave the boot path unchecked. Analysing more is stricter
    # than the gate, never looser.
    paths:
        - app
        - config
        - public
        - scripts

    # Analyse against the locked runtime rather than whatever PHP happens to run the
    # tool, so the result is the same on a developer machine and in the container.
    phpVersion: 80401

    # Report anything the configuration silences but that never actually fires, so
    # this file cannot quietly accumulate stale exclusions.
    reportUnmatchedIgnoredErrors: true

    # A @var/@param annotation that contradicts the real type should fail, not be
    # trusted. Constitution II requires explicit types; this stops a docblock from
    # being used to talk PHPStan out of a genuine finding.
    treatPhpDocTypesAsCertain: true

    # No baseline file, on purpose. A baseline would let existing violations sit
    # indefinitely, which is exactly what the "0 errors" gate exists to prevent.
