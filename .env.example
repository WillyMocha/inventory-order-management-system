# Copy to .env and replace every CHANGE_ME value:  cp .env.example .env
# .env is git-ignored and must stay that way (NFR-005). Placeholders only here.

# --- Application ---
APP_ENV=local
# APP_DEBUG affects server-side log verbosity only, never user-facing output (FR-067)
APP_DEBUG=true
APP_PORT=8080

# --- Database: host is the compose service name, not a machine address ---
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ioms
DB_USERNAME=ioms
DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
# Root is used only by mysql first boot and the README schema/seed step.
# The application itself always connects as DB_USERNAME.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# --- Integration tests: this database is DROPPED and recreated ---
TEST_DB_DATABASE=ioms_test

# --- Session (research R-005) ---
SESSION_NAME=IOMSSESSID
# 30 minutes idle
SESSION_IDLE_TIMEOUT=1800
# 12 hours absolute
SESSION_ABSOLUTE_TIMEOUT=43200
# Set true only when served over HTTPS
SESSION_COOKIE_SECURE=false

# --- Product image upload: 2 MB, type decided by content sniffing (research R-006) ---
UPLOAD_MAX_BYTES=2097152

# --- Sign-in rate limiting (research R-005) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
