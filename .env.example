# Salin file ini menjadi .env sebelum menjalankan docker compose up --build.
# Seluruh nilai di bawah adalah contoh - JANGAN pernah memasukkan credential
# asli ke repository (constitution Principle V, NFR-004).

# --- Application ---
APP_ENV=local
APP_PORT=8080
APP_URL=http://localhost:8080

# Set true hanya bila aplikasi disajikan lewat HTTPS. Mengatur flag Secure
# pada session cookie.
SESSION_SECURE=false

# --- Database ---
# Port yang dipublikasikan ke host. Dipakai HANYA oleh Docker Compose untuk
# memetakan 3306 di dalam container. Default 3307 agar tidak bentrok dengan
# MySQL yang sudah berjalan di host (mis. Laragon, XAMPP).
DB_HOST_PORT=3307

# DB_HOST dan DB_PORT di bawah adalah alamat koneksi saat aplikasi atau test
# dijalankan DARI HOST, di luar Docker. Di dalam container, compose.yaml
# meng-inject db:3306 dan mengabaikan kedua nilai ini.
DB_HOST=127.0.0.1
DB_PORT=3307

DB_DATABASE=ioms
DB_USERNAME=ioms_user
DB_PASSWORD=ioms_secret
DB_ROOT_PASSWORD=root_secret

# Database terpisah yang dipakai integration test.
DB_DATABASE_TEST=ioms_test

# --- Upload ---
# Berada DI LUAR document root (public/). File image product tidak boleh
# dapat diakses langsung lewat URL (research R-006).
UPLOAD_PATH=/var/www/html/storage/uploads
