{
    "name": "ioms/inventory-order-management-system",
    "description": "Inventory & Order Management System — native PHP 8.4, layered architecture, no framework",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "analyse": "phpstan analyse app --level=6",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@analyse",
            "@lint",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the full PHPUnit suite (Unit + Integration; Integration needs MySQL)",
        "test:unit": "Run unit tests only — no database, no network, no filesystem",
        "analyse": "PHPStan at level 6 over app/ — must report 0 errors",
        "lint": "PSR-12 check via PHP_CodeSniffer",
        "check": "Every merge gate that can run without a database"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
