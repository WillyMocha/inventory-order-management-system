<?xml version="1.0"?>
<ruleset name="IOMS">
    <description>PSR-12 coding standard untuk Inventory &amp; Order Management System.</description>

    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>scripts</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!-- declare(strict_types=1) wajib di setiap file (constitution Principle II). -->
    <rule ref="Generic.PHP.RequireStrictTypes"/>
</ruleset>
